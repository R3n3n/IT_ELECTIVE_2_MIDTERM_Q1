@model IT_ELECTIVE_2_MIDTERM_Q1.Models.WeatherViewModel

@{
    ViewData["Title"] = "14-Day Weather Forecast";
}

<div class="container-fluid py-5 px-lg-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">@Model.City</h1>
        <p class="text-muted">Live 14-Day Weather Forecast via WeatherAPI.com</p>
    </div>

    @if (Model.Forecasts != null && Model.Forecasts.Any())
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-7 g-3 justify-content-center">
            @foreach (var day in Model.Forecasts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 text-white text-center p-2" style="background: linear-gradient(135deg, #0d6efd, #0dcaf0);">
                        <div class="card-body p-2 d-flex flex-column justify-content-between">

                            <span class="badge bg-white bg-opacity-25 text-white fw-semibold mb-2" style="font-size: 0.8rem;">@day.Date</span>

                            @if (!string.IsNullOrEmpty(day.Icon))
                            {
                                <div>
                                    <img src="@day.Icon" alt="Icon" style="width: 64px; height: 64px; filter: drop-shadow(0px 2px 4px rgba(0,0,0,0.2));" />
                                </div>
                            }

                            <div>
                                <h4 class="fw-bold mb-1">@Math.Round(day.Temperature)°C</h4>
                                <p class="text-capitalize fw-light text-white-50 mb-2" style="font-size: 0.75rem; line-height: 1.1;">@day.Description</p>
                            </div>

                            <div class="bg-white bg-opacity-10 rounded-3 py-1 px-1">
                                <span class="small text-uppercase fw-semibold text-white-50 d-block" style="font-size: 0.65rem;">Humidity</span>
                                <span class="fw-bold" style="font-size: 0.8rem;">@day.Humidity%</span>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger text-center shadow-sm rounded-4 py-4">
            <h4>Could not load live API data.</h4>
            <p class="mb-0 text-muted">Please ensure your API Key is correct and you have internet access.</p>
        </div>
    }
</div>