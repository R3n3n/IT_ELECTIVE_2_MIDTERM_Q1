@model IT_ELECTIVE_2_MIDTERM_Q1.Models.WeatherViewModel

@{
    ViewData["Title"] = "5-Day Philippines Weather Forecast";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">@Model.City</h1>
        <p class="text-muted">Live 5-Day Weather Forecast via OpenWeatherMap API</p>
    </div>

    @if (Model.Forecasts != null && Model.Forecasts.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4 justify-content-center">
            @foreach (var day in Model.Forecasts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 text-white text-center p-3" style="background: linear-gradient(135deg, #0d6efd, #0dcaf0);">
                        <div class="card-body d-flex flex-column justify-content-between">

                            <span class="badge bg-white bg-opacity-25 text-white fw-semibold mb-3 py-2">@day.Date</span>

                            @if (!string.IsNullOrEmpty(day.Icon))
                            {
                                <div>
                                    <img src="https://openweathermap.org/img/wn/@(day.Icon)@@4x.png" alt="Icon" style="width: 100px; height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.2));" />
                                </div>
                            }

                            <div>
                                <h2 class="fw-bold mb-1">@Math.Round(day.Temperature)°C</h2>
                                <p class="text-capitalize fw-light text-white-50 small mb-3">@day.Description</p>
                            </div>

                            <div class="bg-white bg-opacity-10 rounded-3 py-2 px-2">
                                <span class="small text-uppercase fw-semibold text-white-50 d-block" style="font-size: 0.75rem;">Humidity</span>
                                <span class="fw-bold">@day.Humidity%</span>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger text-center shadow-sm rounded-4 py-4">
            <h4>Could not load live API data.</h4>
            <p class="mb-0 text-muted">Please ensure your API Key is correctly set up in your configuration settings.</p>
        </div>
    }
</div>