@{
    ViewData["Title"] = "User Profile";
}

<div class="profile-container">

    <div class="profile-card">

        <div class="profile-header">
            <img src="~/images/burrrp.png" class="profile-image" alt="Profile Picture">

            <h2>Administrator</h2>
            <p class="role">System Administrator</p>
        </div>

        <div class="profile-info">

            <div class="info-row">
                <span class="label">Username</span>
                <span class="value">Admin</span>
            </div>

            <div class="info-row">
                <span class="label">Email</span>
                <span class="value">brrrrr@gmail.com</span>
            </div>

            <div class="info-row">
                <span class="label">Department</span>
                <span class="value">Information Technology</span>
            </div>

            <div class="info-row">
                <span class="label">Phone</span>
                <span class="value">0912-345-6789</span>
            </div>

            <div class="info-row">
                <span class="label">Address</span>
                <span class="value">Manila, Philippines</span>
            </div>

        </div>

        <div class="profile-buttons">
            <button class="btn-edit">Edit Profile</button>
            <button class="btn-logout">Logout</button>
        </div>

    </div>

</div>